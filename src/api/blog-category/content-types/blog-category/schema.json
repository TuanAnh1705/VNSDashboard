{
  "kind": "collectionType",
  "collectionName": "blog_categories",
  "info": {
    "singularName": "blog-category",
    "pluralName": "blog-categories",
    "displayName": "BlogCategory"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "categoriesName": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "DefaultSEO": {
      "type": "component",
      "component": "section-seo.default-seo",
      "repeatable": false
    },
    "blog_details": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-detail.blog-detail",
      "mappedBy": "categories"
    }
  }
}
